# Copy to .env on the Pi:  cp .env.example .env  (then edit)
# .env is git-ignored and preserved across deploys.

# --- Postgres (compose builds DATABASE_URL for the app from these) ---
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=jobtracker

# --- Local LLM (Ollama) ---
# qwen2.5:1.5b (~1 GB, ~1.5-2 GB RAM) is a good fit for a 3.5 GB Pi.
# Lighter: llama3.2:1b. Sharper (needs more RAM): qwen2.5:3b.
OLLAMA_MODEL=qwen2.5:1.5b

# You normally do NOT set DATABASE_URL / OLLAMA_HOST here — docker compose points
# the app at the db + ollama containers automatically. Set DATABASE_URL only if you
# run the app OUTSIDE compose (e.g. on Windows for development).
# DATABASE_URL=postgresql://jobtracker:change-me-please@localhost:5432/jobtracker
